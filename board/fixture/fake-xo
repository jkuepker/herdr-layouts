#!/usr/bin/env python3 -I
"""A stand-in for the xo CLI the board mod runs: `bearings --rows`, `log --json --lines N`, `act <key> <do> ...`
and `act --state <id>`, with the nine tasks from the mockup. sessions.json beside it maps a slug to a real hc address
(test terminals), so Focus and Go to agent have something to show. Every act call is appended to acts.log.
Its files live in <repo>/.worktrees/board-fixture/, or in $BOARD_FIXTURE_DIR."""
import json
import os
import sys
import time

# what it writes (briefs, acts.log, removed.json) and reads (sessions.json) lives in the repo's ignored .worktrees
HERE = os.environ.get("BOARD_FIXTURE_DIR") or os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..", ".worktrees", "board-fixture")
os.makedirs(HERE, exist_ok=True)
NOW = time.time()
DAY = 86400


def load(name, default):
    try:
        with open(os.path.join(HERE, name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


SESSIONS = load("sessions.json", {})
GONE = set(load("removed.json", []))

TASKS = [
    # project, slug, harness, agent, kind, commits, changed, checks, tokens, added, deleted, reason, next
    ("xo", "pr-43-review", "claude", "blocked", "needs_you", "4", "0", "pass", 1_200_000, 212, 88,
     "the agent is blocked: it asks you something", "xo attach xo/pr-43-review"),
    ("herdr-layouts", "slate-board", "codex", "blocked", "needs_you", "1", "2", "-", 340_000, 64, 20,
     "the agent is blocked: it asks for a permission", "xo attach herdr-layouts/slate-board"),
    ("deepeval", "qwen-bench", "pi", "working", "in_flight", "2", "1", "not run", 640_000, 96, 12,
     "working", ""),
    ("xo", "adopt-agents", "claude", "working", "in_flight", "0", "3", "-", 210_000, 140, 9,
     "working", ""),
    ("fleetq", "eta-fix", "codex", "working", "in_flight", "0", "1", "-", 48_000, 18, 5,
     "working", ""),
    ("unanimis", "recall-speedup", "claude", "idle", "ready", "6", "0", "pass", 1_900_000, 410, 220,
     "checks pass and the agent is idle", "xo merge unanimis/recall-speedup; or xo ship unanimis/recall-speedup"),
    ("xo", "token-column", "claude", "-", "done", "3", "0", "pass", 820_000, 120, 31,
     "merged into main", "xo clean xo"),
    ("herdr-layouts", "needs-you", "claude", "-", "done", "1", "0", "-", 1_100_000, 46, 22,
     "merged into main", "xo clean herdr-layouts"),
    ("fleetq", "reserve-flag", "codex", "-", "done", "4", "0", "pass", 700_000, 196, 18,
     "PR #88 merged", "xo clean fleetq"),
]
TITLES = {
    "pr-43-review": "Review PR #43", "slate-board": "Slate status strip", "qwen-bench": "Benchmark Qwen 3.5 quants",
    "adopt-agents": "Adopt agents started in Herdr", "eta-fix": "Fix ETA for queued jobs",
    "recall-speedup": "Make recall 3× faster", "token-column": "TOKENS column in xo status",
    "needs-you": "Slate: NEEDS YOU + agent icons", "reserve-flag": "fleetq reserve --at",
}


def state():
    rows, bearings = [], []
    for rank, (project, slug, harness, agent, kind, commits, changed, checks, tokens, add, dele, reason, nxt) in enumerate(TASKS):
        key = f"{project}/{slug}"
        if key in GONE:
            continue
        brief = os.path.join(HERE, "briefs", f"{slug}.md")
        os.makedirs(os.path.dirname(brief), exist_ok=True)
        if not os.path.exists(brief):
            with open(brief, "w") as f:
                f.write(f"{TITLES[slug]}\n\nFixture brief for {key}.\n")
        live = kind != "done"
        rows.append({
            "key": key, "project": project, "slug": slug, "harness": harness, "role": None, "host": None,
            "agent": agent, "session_status": "Live" if live else "gone", "session": SESSIONS.get(slug, ""),
            "mux": "hc", "held": False, "commits": commits, "changed": changed, "checks_state": checks,
            "tokens": {"total": tokens}, "added": add, "deleted": dele, "brief": brief,
            "state": "running" if live else "removed", "created": NOW - (rank + 1) * 1500,
        })
        bearings.append({"key": key, "kind": kind, "reason": reason, "next": nxt, "rank": rank})
    return {"rows": rows, "bearings": bearings, "error": None, "when": time.strftime("%H:%M:%S")}


def log(n):
    events = []
    # landed per day this week: Mon..today, newest last
    for days_ago, count in [(4, 2), (3, 3), (2, 1), (1, 4), (0, 3)]:
        for i in range(count):
            events.append({"id": f"ev{days_ago}{i}", "ts": NOW - days_ago * DAY - i * 600 - 60,
                           "kind": "merged" if i % 3 else "shipped", "key": "fixture/landed", "into": "main"})
    events.sort(key=lambda e: e["ts"])
    return events[-n:]


def act(args):
    with open(os.path.join(HERE, "acts.log"), "a") as f:
        f.write(" ".join(args) + "\n")
    if args[0] == "--state":
        return {"id": args[1], "state": "done", "code": 0, "output": "ok (fixture)"}
    key, do = args[0], args[1]
    if do == "remove":
        GONE.add(key)
        with open(os.path.join(HERE, "removed.json"), "w") as f:
            json.dump(sorted(GONE), f)
    aid = args[args.index("--id") + 1] if "--id" in args else "fixture-id"
    return {"id": aid, "key": key, "do": do, "state": "running", "code": None, "output": ""}


def main(argv):
    if argv[:2] == ["bearings", "--rows"]:
        out = state()
    elif argv[:2] == ["log", "--json"]:
        out = log(int(argv[argv.index("--lines") + 1]) if "--lines" in argv else 50)
    elif argv[:1] == ["act"]:
        out = act(argv[1:])
    else:
        print(f"fake-xo: unsupported {' '.join(argv)}", file=sys.stderr)
        return 2
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
