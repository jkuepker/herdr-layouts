{
  "title": "Widget kit",
  "refresh": 30,
  "widgets": [
    { "type": "stat", "title": "Stat", "w": 1, "source": { "type": "static", "data": { "free": 82, "of": 116 } }, "value": ".free", "unit": "GB", "sub": "of {.of} GB", "thresholds": { "below": true, "warn": 15, "bad": 10 }, "spark": true },
    { "type": "stat", "title": "Stat, amber", "w": 1, "source": { "type": "static", "data": 0.87 }, "format": "percent", "thresholds": { "warn": 0.8, "bad": 0.95 } },
    { "type": "stat", "title": "Stat, red", "w": 1, "source": { "type": "static", "data": 7 }, "unit": "GB", "thresholds": { "below": true, "warn": 15, "bad": 10 } },
    { "type": "status", "title": "Status", "w": 2, "source": { "type": "static", "data": [ { "name": "api", "state": "up" }, { "name": "worker", "state": "starting", "note": "2m" }, { "name": "cache", "state": "down" } ] }, "state": ".state", "sub": ".note" },
    { "type": "bars", "title": "Bars", "w": 2, "source": { "type": "static", "data": [ { "name": "spark1", "used": 34, "cap": 116 }, { "name": "spark2", "used": 104, "cap": 116 }, { "name": "tatooine", "used": 31, "cap": 32 } ] }, "value": ".used", "max": ".cap", "unit": "GB", "thresholds": { "warn": 100, "bad": 110 } },
    { "type": "line", "title": "Line", "w": 2, "source": { "type": "static", "data": [
      { "host": "one", "points": [[0,2],[60,4],[120,9],[180,7],[240,12],[300,18],[360,15],[420,21],[480,26],[540,22],[600,30]] },
      { "host": "two", "points": [[0,14],[60,13],[120,12],[180,12],[240,10],[300,9],[360,11],[420,8],[480,6],[540,7],[600,5]] } ] }, "legend": "{.host}", "unit": "tok/s" },
    { "type": "table", "title": "Table", "w": 2, "source": { "type": "static", "data": [ { "name": "herdr-layouts", "branch": "acp-chat", "dirty": 0, "ok": "passing" }, { "name": "fleetq", "branch": "main", "dirty": 12, "ok": "failing" }, { "name": "notes", "branch": "main", "dirty": 3, "ok": null } ] },
      "columns": [ { "title": "Project", "value": ".name" }, { "title": "Branch", "value": ".branch", "w": 80, "align": "left" }, { "title": "Dirty", "value": ".dirty", "w": 48, "thresholds": { "warn": 1, "bad": 10 } }, { "title": "CI", "value": ".ok", "w": 80, "dot": true, "thresholds": { "ok": ["passing"], "warn": ["pending"] } } ] },
    { "type": "list", "title": "List", "w": 2, "source": { "type": "static", "data": [ { "label": "#9144 Pi title test", "owner": "claude", "state": "running" }, { "label": "#9145 nightly eval", "owner": "josef", "state": "queued" } ] }, "text": ".label", "sub": ".owner", "state": ".state" },
    { "type": "gauge", "title": "Gauge", "w": 1, "source": { "type": "static", "data": { "used": 34, "cap": 116 } }, "value": ".used", "max": ".cap", "unit": "GB", "thresholds": { "warn": 100, "bad": 110 } },
    { "type": "gauge", "title": "Gauge, amber", "w": 1, "source": { "type": "static", "data": 87 }, "unit": "%", "thresholds": { "warn": 80, "bad": 95 }, "sub": "KV cache" },
    { "type": "heatmap", "title": "Heatmap, from a range", "w": 2, "source": { "type": "static", "data": [
      { "host": "spark1", "points": [[0,5],[3600,12],[7200,40],[10800,85],[14400,92],[18000,60],[21600,22],[25200,8]] },
      { "host": "spark2", "points": [[0,0],[3600,0],[7200,15],[10800,30],[14400,75],[18000,98],[21600,70],[25200,35]] },
      { "host": "tatooine", "points": [[0,3],[3600,3],[7200,4],[10800,2],[14400,3],[18000,6],[21600,3],[25200,3]] } ] },
      "label": "{.host}", "steps": 8, "unit": "%", "max": 100 },
    { "type": "heatmap", "title": "Heatmap, rows by columns, with thresholds", "w": 2, "source": { "type": "static", "data": [
      { "box": "spark1", "day": "Mon", "v": 12 }, { "box": "spark1", "day": "Tue", "v": 85 }, { "box": "spark1", "day": "Wed", "v": 97 },
      { "box": "spark2", "day": "Mon", "v": 40 }, { "box": "spark2", "day": "Tue", "v": 20 }, { "box": "spark2", "day": "Wed", "v": 81 } ] },
      "row": ".box", "col": ".day", "value": ".v", "unit": "%", "thresholds": { "warn": 80, "bad": 95 } },
    { "type": "text", "title": "Text, Markdown", "w": 2, "text": "**Markdown** written in the file: a list,\n\n- `code`\n- a [link](https://example.com)\n\nand a second paragraph." },
    { "type": "text", "title": "Text, from a source", "w": 1, "plain": true, "source": { "type": "command", "shell": "date '+%A %H:%M'; uname -sm" } },
    { "type": "log", "title": "Log", "w": 2, "lines": 5, "source": { "type": "command", "shell": "git -C /opt/code/herdr-layouts log --oneline -8 | tail -r", "parse": "lines" } },
    { "type": "link", "title": "Link, a Herdr command", "w": 1, "label": "Command palette", "run": "mod.open:ht3-palette" },
    { "type": "link", "title": "Link, a web address", "w": 1, "label": "Prometheus", "url": "http://192.168.1.126:9090" },
    { "type": "link", "title": "Link, a space", "w": 1, "label": "Home", "space": "Home" },
    { "type": "terminal", "title": "Terminal", "w": 2, "label": "Say hello", "command": "echo hello from the dashboard" },
    { "type": "chat", "title": "Chat", "w": 2 },
    { "type": "plan-map", "title": "Plan map", "w": 4, "view": "fleet", "layout": "compact" },
    { "type": "list", "title": "Empty", "w": 1, "source": { "type": "static", "data": [] }, "empty": "Nothing queued" },
    { "type": "stat", "title": "A dead source", "w": 1, "broken": true, "source": { "type": "nowhere" } },
    { "type": "pie", "title": "An unknown type", "w": 1, "broken": true, "source": { "type": "static", "data": 1 } }
  ]
}
